# ==============================================================================
# AI Consulting Workflow Platform — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and populate with deployment-specific credentials.
# Do NOT commit actual secrets or production API keys to source control.

# ------------------------------------------------------------------------------
# Infrastructure & Database
# ------------------------------------------------------------------------------
# Async PostgreSQL connection string (postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>)
DATABASE_URL=postgresql+asyncpg://consulting:consulting@localhost:5432/consulting_db

# Redis connection URL for application event bus & Celery broker
REDIS_URL=redis://localhost:6379/0

# Cryptographic secret key used for signing JWT tokens and session data (min 32 chars)
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production-min-32-chars

# Environment profile: development | staging | production
ENVIRONMENT=development

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Celery Asynchronous Worker
# ------------------------------------------------------------------------------
# Celery task queue broker URL
CELERY_BROKER_URL=redis://localhost:6379/1

# Celery result storage backend URL
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ------------------------------------------------------------------------------
# AI Models & Web Search Providers
# ------------------------------------------------------------------------------
# LLM Provider adapter: gemini | openai | mock
LLM_PROVIDER=gemini

# Google Gemini API Key (required when LLM_PROVIDER=gemini, model: gemini-3.8-flash)
GEMINI_API_KEY=your-gemini-api-key-here

# OpenAI API Key (optional alternative when LLM_PROVIDER=openai)
#OPENAI_API_KEY=your-openai-api-key-here

# Web Search Provider adapter: serpapi | mock
SEARCH_PROVIDER=serpapi

# SerpAPI Key for Google search retrieval (required when SEARCH_PROVIDER=serpapi)
SERPAPI_KEY=your-serpapi-key-here

# ------------------------------------------------------------------------------
# Observability & Tracing (Langfuse)
# ------------------------------------------------------------------------------
# Langfuse project public API key
LANGFUSE_PUBLIC_KEY=

# Langfuse project secret API key
LANGFUSE_SECRET_KEY=

# Langfuse host URL
LANGFUSE_HOST=https://cloud.langfuse.com

# ------------------------------------------------------------------------------
# Webhooks & External Notifications
# ------------------------------------------------------------------------------
# Default Slack Incoming Webhook URL for human review gate alerts (optional)
SLACK_WEBHOOK_URL=

# Default Microsoft Teams Incoming Webhook URL for human review gate alerts (optional)
TEAMS_WEBHOOK_URL=

# Frontend base URL used for deep-links in webhook notifications
FRONTEND_BASE_URL=http://localhost:3000

# Deliverable artifact retention period in days before automated cleanup
ARTIFACT_RETENTION_DAYS=7
